    {
      "tag": "v0.2.7",
      "url": "https://github.com/plasticbugs/parrot-plugin-sms-gamegear/releases/tag/v0.2.7",
      "published": "2026-11-24",
      "version": "0.2.7",
      "notes": "Changes since 0.2.5:\n\n- A game pad already on a powered hub when you start is found, and pads plugged in or pulled out while you play are seen.\n- Hold both fire buttons and * on controller 1 for 2 seconds, or Select and Start on a USB pad, to go back to the menu."
    },
    {
      "tag": "v0.2.5",
      "url": "https://github.com/plasticbugs/parrot-plugin-sms-gamegear/releases/tag/v0.2.5",
      "published": "2026-11-19",
      "version": "0.2.5",
      "notes": "The cart now reads the console's address lines twice, and answers only when the two agree. This is the bus loop that fixed the glitches in The Empire Strikes Back 0.1.4."
    },
    {
