  "history": [
    {
      "tag": "v0.1.5",
      "url": "https://github.com/plasticbugs/parrot-plugin-lua/releases/tag/v0.1.5",
      "published": "2026-11-24",
      "version": "0.1.5",
      "notes": "Hold both fire buttons and * on controller 1 for 2 seconds, or Select and Start on a USB pad, to go back to the menu. RESET still works too."
    },
    {
      "tag": "v0.1.4",
      "url": "https://github.com/plasticbugs/parrot-plugin-lua/releases/tag/v0.1.4",
      "published": "2026-11-22",
      "version": "0.1.4",
      "notes": "- Lua starts without a file too, so the cart's menu lists it in Apps. It opens with the list of scripts on the card.\n- The sound goes out to the console every 0.1 s as well as whenever a script changes it. The console misreads a byte from the cart now and then, and before this one bad byte could leave a note playing until RESET.\n- A USB pad, keyboard, mouse or MIDI keyboard on a powered hub is found when it was plugged in before Lua started, and when it's plugged in or pulled out while Lua runs. With some hubs it wasn't found before."
    },
    {
      "tag": "v0.1.0",
