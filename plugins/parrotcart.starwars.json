  "history": [
    {
      "tag": "v0.1.9",
      "url": "https://github.com/plasticbugs/parrot-plugin-starwars/releases/tag/v0.1.9",
      "published": "2026-11-24",
      "version": "0.1.9",
      "notes": "Hold both fire buttons and * on controller 1 for 2 seconds, or Select and Start on a USB pad, to go back to the menu. RESET still works too."
    },
    {
      "tag": "v0.1.8",
      "url": "https://github.com/plasticbugs/parrot-plugin-starwars/releases/tag/v0.1.8",
      "published": "2026-11-22",
      "version": "0.1.8",
      "notes": "- Keypad * or # adds a coin, and keypad 1 starts the game, the same keys as the other arcade plugins. On a USB pad, minus is the coin and plus the start, as before.\n- The plugin now finds a pad that is already on a powered hub when the game starts, and one you plug in while it runs.\n- The cart now sends the sound chip's whole state with every frame, so a byte the console misreads can't leave a tone stuck on."
    },
    {
      "tag": "v0.1.5",
      "url": "https://github.com/plasticbugs/parrot-plugin-starwars/releases/tag/v0.1.5",
      "published": "2026-11-19",
      "version": "0.1.5",
      "notes": "The cart now reads the console's address lines twice, and answers only when the two agree. This is the bus loop that fixed the glitches in The Empire Strikes Back 0.1.4."
    },
    {
      "tag": "v0.1.4",
      "url": "https://github.com/plasticbugs/parrot-plugin-starwars/releases/tag/v0.1.4",
      "published": "2026-11-17",
      "version": "0.1.4",
      "notes": "**Full Changelog**: https://github.com/plasticbugs/parrot-plugin-starwars/commits/v0.1.4"
    }
  ],
