      "tag": "v0.1.3",
      "url": "https://github.com/plasticbugs/parrot-plugin-gameboy/releases/tag/v0.1.3",
      "published": "2026-11-19",
      "version": "0.1.3",
      "notes": "The cart now reads the console's address lines twice, and answers only when the two agree. This is the bus loop that fixed the glitches in The Empire Strikes Back 0.1.4."
    },
