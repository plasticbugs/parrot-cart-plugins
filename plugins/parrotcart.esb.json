  "history": [
    {
      "tag": "v0.1.7",
      "url": "https://github.com/plasticbugs/parrot-plugin-esb/releases/tag/v0.1.7",
      "published": "2026-11-22",
      "version": "0.1.7",
      "notes": "- Keypad * or # adds a coin, and keypad 1 starts the game, the same keys as the other arcade plugins. On a USB pad, minus is the coin and plus the start, as before.\n- The plugin now finds a pad that is already on a powered hub when the game starts, and one you plug in while it runs.\n- The cart now sends the sound chip's whole state with every frame, so a byte the console misreads can't leave a tone stuck on."
    },
    {
      "tag": "v0.1.4",
      "url": "https://github.com/plasticbugs/parrot-plugin-esb/releases/tag/v0.1.4",
      "published": "2026-11-18",
      "version": "0.1.4",
      "notes": "Fixes the glitches on the console. The cart now reads the console's address lines twice before it answers."
    }
  ],
