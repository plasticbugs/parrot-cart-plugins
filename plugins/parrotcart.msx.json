  "history": [
    {
      "tag": "v0.1.2",
      "url": "https://github.com/plasticbugs/parrot-plugin-msx/releases/tag/v0.1.2",
      "published": "2026-11-24",
      "version": "0.1.2",
      "notes": "Changes since 0.1.0:\n\n- A USB pad, keyboard or mouse already on a powered hub when you start is found, and ones plugged in or pulled out while you play are seen.\n- Hold both fire buttons and * on controller 1 for 2 seconds, or Select and Start on a USB pad, to go back to the menu."
    },
    {
      "tag": "v0.1.0",
      "url": "https://github.com/plasticbugs/parrot-plugin-msx/releases/tag/v0.1.0",
      "published": "2026-11-20",
      "version": "0.1.0",
      "notes": "The first release. It plays MSX1 cartridge games with C-BIOS built in, or your own BIOS, and supports the ASCII8, ASCII16, Konami, Konami SCC and R-Type cartridges and battery saves. The ColecoVision controller, USB pads, a USB keyboard and a USB mouse all work as MSX controls."
    }
